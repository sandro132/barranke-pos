# Base de datos (SQLite en desarrollo)
DATABASE_URL="file:./dev.db"

# Puerto del servidor
PORT=4000

# Secreto para firmar JWT (cámbialo en producción por algo largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN="http://localhost:5173"
