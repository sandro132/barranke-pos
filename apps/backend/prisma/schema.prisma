generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite en desarrollo. En producción, cambiar a "postgresql" y actualizar DATABASE_URL.
  // NOTA IMPORTANTE: SQLite no soporta enums nativos de Prisma, por eso los campos
  // de tipo "enum" de negocio se guardan como String aquí. La validez de esos valores
  // se garantiza con los enums de TypeScript en packages/shared y los schemas de Zod
  // en cada módulo del backend (nunca se guarda un valor arbitrario).
  // Si en el futuro se migra a PostgreSQL, estos campos String pueden convertirse
  // a enums nativos de Prisma sin cambiar la lógica de negocio.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================
// USUARIOS Y AUTH
// =========================

/// Valores válidos: ADMIN | MESERO | COCINA | BAR
model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("MESERO")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  pedidos               Pedido[]
  movimientosCaja       MovimientoCaja[]
  ventas                Venta[]
  movimientosInventario MovimientoInventario[]
  cuentas               Cuenta[]
}

// =========================
// ESPACIOS (MESAS Y BARRAS)
// =========================

model Espacio {
  id     String @id @default(cuid())
  nombre String
  /// Valores válidos: MESA | BARRA
  tipo      String
  capacidad Int?

  cuentas Cuenta[]
}

// Reemplaza el rol operativo que antes tenía Espacio (estado OCUPADA,
// horaApertura, etc.): una cuenta es "a nombre de quién" (ej. "Juan",
// "Cumpleaños María"), no de una mesa. Una mesa puede tener varias cuentas
// abiertas al mismo tiempo (grupos distintos en la misma mesa), o ninguna
// (cuenta de alguien parado en la barra). El espacio queda como referencia
// opcional, solo para que el mesero sepa dónde entregar.
model Cuenta {
  id     String @id @default(cuid())
  nombre String
  /// Valores válidos: ABIERTA | CERRADA
  estado       String   @default("ABIERTA")
  horaApertura DateTime @default(now())
  descripcion  String?

  espacioId String?
  espacio   Espacio? @relation(fields: [espacioId], references: [id], onDelete: SetNull)

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  pedidos Pedido[]
  ventas  Venta[]

  // Unir cuentas: igual que antes se unían mesas, ahora se unen cuentas
  // (ej. dos grupos que al final deciden pagar juntos).
  cuentaPadreId String?
  cuentaPadre   Cuenta?  @relation("CuentasUnidas", fields: [cuentaPadreId], references: [id])
  cuentasHijas  Cuenta[] @relation("CuentasUnidas")

  createdAt DateTime @default(now())
}

// =========================
// CATEGORÍAS
// =========================

// Antes las categorías eran una lista fija en el código (Cerveza, Licor,
// Comida, Cóctel, Otro). Ahora son una tabla real: se crean, editan y
// borran desde la app, sin tener que tocar código nunca más.
model Categoria {
  id     String @id @default(cuid())
  nombre String @unique
  // Prefijo para el código interno (SKU) automático de sus productos,
  // ej. "MEC" para Mecato -> MEC-001, MEC-002...
  prefijoSku String @unique
  // A qué pantalla van los pedidos de productos de esta categoría:
  // COCINA (se prepara), BARRA (se prepara), o NINGUNA (se sirve directo,
  // como una cerveza — no requiere que nadie lo "prepare").
  /// Valores válidos: COCINA | BARRA | NINGUNA
  areaPreparacion String @default("NINGUNA")

  productos Producto[]
  createdAt DateTime   @default(now())
}

// =========================
// PRODUCTOS
// =========================

model Producto {
  id String @id @default(cuid())

  nombre      String
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  // Decimal para dinero en COP. En la práctica se maneja sin decimales (ej. 8000.00 = $8.000)
  precio        Decimal
  costo         Decimal
  stock         Decimal @default(0) // relevante solo si no tiene receta (ej. cerveza)
  stockMinimo   Decimal @default(0) // para la alerta de "stock bajo" (0 = sin alerta)
  unidad        String
  imagenUrl     String?
  activo        Boolean @default(true)
  codigoInterno String  @unique // SKU autogenerado, ej. CERV-001

  receta      RecetaItem[]
  itemsPedido ItemPedido[]
  movimientos MovimientoInventario[]
  itemsCompra ItemCompra[]
  promociones Promocion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// INGREDIENTES Y RECETAS
// =========================

model Ingrediente {
  id     String @id @default(cuid())
  nombre String
  /// Valores válidos: UNIDAD | GRAMO | KILOGRAMO | MILILITRO | LITRO | ONZA | BOTELLA
  unidad        String
  stock         Decimal @default(0)
  stockMinimo   Decimal @default(0)
  costoUnitario Decimal @default(0)

  usadoEnRecetas RecetaItem[]
  movimientos    MovimientoInventario[]
  itemsCompra    ItemCompra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecetaItem {
  id            String      @id @default(cuid())
  productoId    String
  producto      Producto    @relation(fields: [productoId], references: [id])
  ingredienteId String
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id])
  cantidad      Decimal

  @@unique([productoId, ingredienteId])
}

// =========================
// INVENTARIO (MOVIMIENTOS)
// =========================

model MovimientoInventario {
  id String @id @default(cuid())

  /// Valores válidos: ENTRADA | SALIDA | AJUSTE | VENTA | COMPRA | CONSUMO_INTERNO
  tipo     String
  cantidad Decimal
  motivo   String?
  fecha    DateTime @default(now())

  productoId    String?
  producto      Producto?    @relation(fields: [productoId], references: [id])
  ingredienteId String?
  ingrediente   Ingrediente? @relation(fields: [ingredienteId], references: [id])

  // Si este movimiento vino de una compra, queda vinculado a ella — así, si
  // la compra se anula después, se puede borrar exactamente estos
  // movimientos y revertir el stock, sin adivinar cuáles son.
  compraId String?
  compra   Compra? @relation(fields: [compraId], references: [id])

  // Quién lo hizo (relevante sobre todo para CONSUMO_INTERNO, para saber a
  // quién preguntarle si algo no cuadra). Nulo en movimientos automáticos
  // del sistema (ventas, compras) donde no aplica una persona puntual.
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}

// =========================
// PEDIDOS
// =========================

model Pedido {
  id       String  @id @default(cuid())
  cuentaId String
  cuenta   Cuenta  @relation(fields: [cuentaId], references: [id])
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  /// Valores válidos: PENDIENTE | PREPARANDO | LISTO | ENTREGADO | CANCELADO
  estado    String   @default("PENDIENTE")
  createdAt DateTime @default(now())

  // Se llena cuando se cierra la mesa: permite reconstruir el ticket de una
  // venta pasada (qué pedidos/ítems incluía), ya que Venta no guarda los
  // ítems directamente.
  ventaId String?
  venta   Venta?  @relation(fields: [ventaId], references: [id])

  items ItemPedido[]
}

model ItemPedido {
  id             String   @id @default(cuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal // snapshot del precio al momento de vender
  /// Valores válidos: COCINA | BARRA | NINGUNA
  areaPreparacion String @default("NINGUNA")
  /// Valores válidos: PENDIENTE | PREPARANDO | LISTO | ENTREGADO | CANCELADO
  estado String  @default("PENDIENTE")
  notas  String?
}

// =========================
// VENTAS (CIERRE DE MESA/BARRA)
// =========================

model Venta {
  id       String @id @default(cuid())
  cuentaId String
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  subtotal  Decimal
  descuento Decimal @default(0)
  total     Decimal
  /// Valores válidos: EFECTIVO | TRANSFERENCIA_BANCOLOMBIA | NEQUI | DAVIPLATA | TARJETA | OTRO | FIADO
  metodoPago String
  fecha      DateTime @default(now())

  cajaId String?
  caja   Caja?   @relation(fields: [cajaId], references: [id])

  // Solo se usa cuando metodoPago = FIADO: a qué cliente se le fía esta venta.
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  pedidos           Pedido[]
  movimientoCuenta  MovimientoCuentaCliente?
  movimientoCaja    MovimientoCaja?
}

// =========================
// CAJA
// =========================

model Caja {
  id            String    @id @default(cuid())
  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?
  montoInicial  Decimal
  montoFinal    Decimal?
  abierta       Boolean   @default(true)

  movimientos MovimientoCaja[]
  ventas      Venta[]
}

model MovimientoCaja {
  id     String @id @default(cuid())
  cajaId String
  caja   Caja   @relation(fields: [cajaId], references: [id])
  /// Valores válidos: APERTURA | CIERRE | INGRESO | GASTO | VENTA
  tipo        String
  monto       Decimal
  descripcion String?
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  fecha       DateTime @default(now())

  // Si este movimiento vino de cerrar una mesa (tipo VENTA), queda vinculado
  // a esa venta — así, si la venta se anula después, se puede borrar
  // exactamente este movimiento, sin adivinar cuál es.
  ventaId String? @unique
  venta   Venta?  @relation(fields: [ventaId], references: [id])
}

// =========================
// COMPRAS
// =========================

// Antes el proveedor era solo texto libre en cada compra (riesgo de que
// "Distribuidora X" y "distribuidora x" queden como si fueran distintos).
// Ahora es una tabla real, igual que las categorías.
model Proveedor {
  id        String   @id @default(cuid())
  nombre    String   @unique
  telefono  String?
  contacto  String?
  notas     String?
  createdAt DateTime @default(now())

  compras Compra[]
}

model Compra {
  id          String   @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  factura     String?
  fecha       DateTime @default(now())
  total       Decimal

  items       ItemCompra[]
  movimientos MovimientoInventario[]
}

model ItemCompra {
  id            String       @id @default(cuid())
  compraId      String
  compra        Compra       @relation(fields: [compraId], references: [id])
  productoId    String?
  producto      Producto?    @relation(fields: [productoId], references: [id])
  ingredienteId String?
  ingrediente   Ingrediente? @relation(fields: [ingredienteId], references: [id])
  cantidad      Decimal
  costoUnitario Decimal
}

// =========================
// PROMOCIONES (preparado, no activo aún)
// =========================

// Ahora sí conectada al flujo real de pedidos (antes solo se podían crear,
// no se aplicaban a nada). Por ahora solo el tipo COMBO se aplica de verdad
// ("N unidades por $X"); los demás tipos siguen guardándose para el futuro.
model Promocion {
  id String @id @default(cuid())

  nombre String
  /// Valores válidos: HAPPY_HOUR | DOS_POR_UNO | COMBO | DESCUENTO
  tipo       String
  activa     Boolean @default(false)
  horaInicio String?
  horaFin    String?
  diasSemana String?
  valor      Decimal?

  // Solo aplica para tipo COMBO: a qué producto, cuántas unidades, y a qué
  // precio total ese combo (ej. 5 empanadas por $6.000).
  productoId        String?
  producto          Producto? @relation(fields: [productoId], references: [id])
  cantidadRequerida Int?
  precioCombo       Decimal?
}

// =========================
// CLIENTES (preparado, no activo aún)
// =========================

model Cliente {
  id         String    @id @default(cuid())
  nombre     String
  telefono   String?   @unique
  cumpleanos DateTime?
  createdAt  DateTime  @default(now())

  ventas             Venta[]
  movimientosCuenta  MovimientoCuentaCliente[]
}

// Historial de "fiado": cada consumo que se le carga a la cuenta de un
// cliente (CARGO, generado automáticamente al cerrar una mesa con método
// FIADO) y cada pago que hace para saldar su deuda (ABONO, registrado a
// mano desde su ficha). El saldo actual de un cliente es simplemente la
// suma de sus CARGO menos la suma de sus ABONO — no se guarda como un
// número aparte, para que nunca se desincronice del historial real.
model MovimientoCuentaCliente {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  /// Valores válidos: CARGO | ABONO
  tipo        String
  monto       Decimal
  descripcion String?
  fecha       DateTime @default(now())

  // Si este movimiento vino de cerrar una mesa como fiado, queda vinculado
  // a esa venta (para trazabilidad). Los abonos no tienen venta asociada.
  ventaId String? @unique
  venta   Venta?  @relation(fields: [ventaId], references: [id])
}
