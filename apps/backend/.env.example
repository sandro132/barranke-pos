# Base de datos (PostgreSQL — en Railway, copia el DATABASE_URL que te da
# el servicio de Postgres que agregues al proyecto)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# Puerto del servidor
PORT=4000

# Secreto para firmar JWT (cámbialo en producción por algo largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# Orígenes permitidos para CORS (separados por coma si son varios).
# 5173 = modo desarrollo (npm run dev), 4173 = preview de producción (npm run preview)
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
