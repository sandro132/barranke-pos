# IMPORTANTE: para el uso normal (npm run build + el backend sirviéndolo todo
# desde un solo puerto), deja este archivo VACÍO o bórralo — el frontend usa
# rutas relativas por defecto, que funcionan automáticamente sin importar si
# entras por localhost, por la IP de tu red, o por un dominio público (túnel).
#
# Estas variables SOLO son necesarias si corres el frontend por separado en
# modo desarrollo (npm run dev en el puerto 5173, con el backend en otro
# puerto). En ese caso, descomenta y ajusta:
#
# VITE_API_URL="http://localhost:4000/api"
# VITE_SOCKET_URL="http://localhost:4000"
